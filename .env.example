NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GINGR_SUBDOMAIN=fitdog
GINGR_API_KEY=
GINGR_WEBHOOK_SIGNATURE_KEY=
GINGR_LOCATION_ID=1
GINGR_TYPE_IDS=
GINGR_SYNC_SECRET=

# Admin auth — prefer ADMIN_PASSWORD_HASH in production (generate: npx tsx scripts/hash-admin-password.ts your-password)
# Username "admin" aliases to Lonnie Sandoval (lonnie@fitdog.com) Super Admin.
ADMIN_USERNAME=lonnie@fitdog.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

LOBBY_DISPLAY_TOKEN=
# Optional. Embeds ?token= in lobby cast URLs. Lobby board reads stay open so any staff member can cast.
NEXT_PUBLIC_GOOGLE_CAST_APP_ID=

# Shelly Plug US Gen4 alert light — server-only (never expose SHELLY_AUTH_KEY to the browser)
SHELLY_ALERT_ENABLED=false
SHELLY_CLOUD_HOST=https://shelly-267-eu.shelly.cloud
SHELLY_AUTH_KEY=
SHELLY_DEVICE_ID=
SHELLY_CHANNEL=0
SHELLY_MIN_SECONDS_BETWEEN_ALERTS=2
# Push notice alert light duration in seconds (default 300 = 5 minutes)
SHELLY_PUSH_NOTICE_DURATION_SECONDS=300
LOBBY_CHECKOUT_DISPLAY_MINUTES=10
NEXT_PUBLIC_SITE_URL=https://staff.ruffops.com
CRON_SECRET=

# Fitdog Operations Alerts (server-only — never expose to the browser / lobby / CAST-TV)
# api = OAuth + employees/activity-stream (fast). playwright = browser fallback.
FITDOG_INTEGRATION_MODE=api
FITDOG_API_BASE_URL=
FITDOG_API_TOKEN=
FITDOG_WEBHOOK_SECRET=
FITDOG_EMPLOYEE_EMAIL=
FITDOG_EMPLOYEE_PASSWORD=
# Optional overrides for Fitdog's public web OAuth client (defaults match app.fitdog.com)
FITDOG_OAUTH_CLIENT_ID=
FITDOG_OAUTH_CLIENT_SECRET=
FITDOG_SESSION_ENCRYPTION_KEY=
FITDOG_SYNC_ENABLED=true
FITDOG_MISSED_PAYMENT_GRACE_MINUTES=60
FITDOG_BACKFILL_DAYS=365
FITDOG_RECONCILIATION_DAYS=30
# Activity older than this is imported into Past Alerts as resolved
FITDOG_HISTORY_RESOLVE_HOURS=48

# HR Consult — Gemini (server-only; never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ruffly — Fitdog Customer Care (server-only secrets; never expose to browser / lobby / CAST-TV)
RUFFLY_ENABLED=false
RUFFLY_WEBCHAT_ENABLED=false
RUFFLY_AI_ENABLED=false
RUFFLY_VOICE_ENABLED=false
RUFFLY_CAMPAIGNS_ENABLED=false
RUFFLY_AUTOMATIONS_ENABLED=false
RUFFLY_SENDING_SMS_ENABLED=false
RUFFLY_SENDING_EMAIL_ENABLED=false
RUFFLY_PUBLIC_URL=https://ruffly.ruffops.com
RUFFLY_TOKEN_SECRET=
RUFFLY_GOOGLE_REVIEW_URL=
RUFFLY_FACEBOOK_REVIEW_URL=
RUFFLY_WEBCHAT_ALLOWED_ORIGINS=https://fitdog.com,https://www.fitdog.com,https://ruffly.ruffops.com
RUFFLY_WEBCHAT_SITE_KEY=
RUFFLY_API_BASE_URL=https://staff.ruffops.com
RUFFLY_REVIEW_DELAY_MINUTES=120
# Keep false until Twilio signature + send tests pass in production
RUFFLY_SMS_WEBHOOK_SKIP_VERIFY=false
RUFFLY_SMS_WEBHOOK_URL=https://staff.ruffops.com/api/ruffly/webhooks/sms
# Optional Gingr API base override (defaults to https://$GINGR_SUBDOMAIN.gingrapp.com)
GINGR_BASE_URL=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (Resend)
RESEND_API_KEY=
RUFFLY_EMAIL_FROM=
# Voice provider (adapter placeholder)
RUFFLY_VOICE_PROVIDER=

# Route Generator (server-only — never expose to browser / lobby / CAST-TV)
ROUTE_GENERATOR_ENABLED=false
# Live Pull Report uses Fitdog employee OAuth (same as Alerts) when credentials are set.
# Set true in production after verifying a real pull; fixtures are only used when credentials are absent.
FITDOG_REPORT_SYNC_ENABLED=false
ROUTE_OPTIMIZATION_ENABLED=false
SAMSARA_CSV_EXPORT_ENABLED=false
SAMSARA_DIRECT_SYNC_ENABLED=false
# Bearer token for live van GPS (owner Uber-style tracking + 30/15 min ETA alerts)
SAMSARA_API_TOKEN=
ROUTE_WORKER_URL=
ROUTE_WORKER_SIGNING_SECRET=
ROUTE_WORKER_CALLBACK_SECRET=
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
FITDOG_SECRET_REFERENCE=
SAMSARA_SECRET_REFERENCE=
ROUTE_SOURCE_RETENTION_DAYS=90

# Automatic Blog — Fitdog editorial publishing (server-only secrets)
BLOG_ENABLED=true
BLOG_PUBLIC_ENABLED=true
# Optional alternate Google Generative AI env name (also accepts GEMINI_API_KEY)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Cursor API key: enter manually in Vercel/host env. This app cannot create or retrieve Cursor keys.
CURSOR_API_KEY=
FITDOG_BLOG_PROVIDER=native
FITDOG_BLOG_BASE_URL=
FITDOG_BLOG_API_URL=
FITDOG_BLOG_API_TOKEN=
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
