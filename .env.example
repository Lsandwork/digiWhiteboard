GINGR_API_KEY=
GINGR_WEBHOOK_SIGNATURE_KEY=
GINGR_LOCATION_ID=1
GINGR_TYPE_IDS=
GINGR_SYNC_SECRET=

# Admin auth — prefer ADMIN_PASSWORD_HASH in production (generate: npx tsx scripts/hash-admin-password.ts your-password)
# Username "admin" aliases to Lonnie Sandoval (lonnie@fitdog.com) Super Admin.
ADMIN_USERNAME=lonnie@fitdog.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

LOBBY_DISPLAY_TOKEN=
# Optional. Embeds ?token= in lobby cast URLs. Lobby board reads stay open so any staff member can cast.
NEXT_PUBLIC_GOOGLE_CAST_APP_ID=

# Shelly Plug US Gen4 alert light — server-only (never expose SHELLY_AUTH_KEY to the browser)
SHELLY_ALERT_ENABLED=false
SHELLY_CLOUD_HOST=https://shelly-267-eu.shelly.cloud
SHELLY_AUTH_KEY=
SHELLY_DEVICE_ID=
SHELLY_CHANNEL=0
SHELLY_MIN_SECONDS_BETWEEN_ALERTS=2
# Push notice alert light duration in seconds (default 300 = 5 minutes)
SHELLY_PUSH_NOTICE_DURATION_SECONDS=300
LOBBY_CHECKOUT_DISPLAY_MINUTES=10
NEXT_PUBLIC_SITE_URL=https://staff.ruffops.com
CRON_SECRET=

# Fitdog Operations Alerts (server-only — never expose to the browser / lobby / CAST-TV)
# api = OAuth + employees/activity-stream (fast). playwright = browser fallback.
FITDOG_INTEGRATION_MODE=api
FITDOG_API_BASE_URL=
FITDOG_API_TOKEN=
FITDOG_WEBHOOK_SECRET=
FITDOG_EMPLOYEE_EMAIL=
FITDOG_EMPLOYEE_PASSWORD=
# Optional overrides for Fitdog's public web OAuth client (defaults match app.fitdog.com)
FITDOG_OAUTH_CLIENT_ID=
FITDOG_OAUTH_CLIENT_SECRET=
FITDOG_SESSION_ENCRYPTION_KEY=
FITDOG_SYNC_ENABLED=true
FITDOG_MISSED_PAYMENT_GRACE_MINUTES=60
FITDOG_BACKFILL_DAYS=365
FITDOG_RECONCILIATION_DAYS=30
# Activity older than this is imported into Past Alerts as resolved
FITDOG_HISTORY_RESOLVE_HOURS=48

# HR Consult — Gemini (server-only; never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ruffly — Fitdog Customer Care (server-only secrets; never expose to browser / lobby / CAST-TV)
RUFFLY_ENABLED=false
RUFFLY_WEBCHAT_ENABLED=false
RUFFLY_AI_ENABLED=false
RUFFLY_VOICE_ENABLED=false
RUFFLY_CAMPAIGNS_ENABLED=false
