RUFFLY_REVIEW_DELAY_MINUTES=120
# Keep false until Twilio signature + send tests pass in production
RUFFLY_SMS_WEBHOOK_SKIP_VERIFY=false
RUFFLY_SMS_WEBHOOK_URL=https://staff.ruffops.com/api/ruffly/webhooks/sms
